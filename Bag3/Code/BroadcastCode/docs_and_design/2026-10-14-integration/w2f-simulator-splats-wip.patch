diff --git a/Bag3/Code/Simulator/js/panels/peers.js b/Bag3/Code/Simulator/js/panels/peers.js
new file mode 100644
index 0000000..02ec64a
--- /dev/null
+++ b/Bag3/Code/Simulator/js/panels/peers.js
@@ -0,0 +1,131 @@
+/**
+ * Peer strip for <sim-room>: one compact row per virtual peer (js/peers.js)
+ * and the room's pw_* bus log. Shown for party games only.
+ *
+ * Row: identity color, MAC, mode and state, Splat count, and buttons:
+ * "button" (a follower's wand button: pw_msg {"b": 1} to the leader, what
+ * partytest's followers send), "drop"/"back" (silence the peer, for
+ * wand_lost), and "start"/"end" on a leader peer. "+ peer" / "+ leader"
+ * add peers.
+ *
+ *   setPeers(peers)   rows to show
+ *   refresh()         redraw rows after a peer change
+ *   pushLog(line)     one bus log line
+ *   clearLog()
+ */
+
+import { decodePw } from "../peers.js";
+
+const LOG_LIMIT = 80;
+
+export const PEERS_STYLE = `
+.peer-strip { display: flex; flex-direction: column; gap: 6px; }
+.peer-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.8rem; }
+.peer-row .swatch { width: 14px; height: 14px; border-radius: 4px; border: 1px solid #0002; }
+.peer-row .mac { font: 12px ui-monospace, monospace; }
+.peer-row .state { color: #8b859a; min-width: 7em; }
+.peer-row.dropped .state { color: #d13a7c; }
+.peer-strip button { font: 700 0.75rem 'Nunito', system-ui, sans-serif; padding: 3px 9px;
+  border-radius: 10px; border: 1.5px solid #e8e6f0; background: #fff; cursor: pointer; }
+.peer-strip .add { display: flex; gap: 6px; }
+.peer-strip .buslog { font: 11px/1.35 ui-monospace, monospace; max-height: 160px; overflow-y: auto;
+  background: #f7f7fb; border-radius: 8px; padding: 6px 8px; margin: 0; white-space: pre-wrap;
+  word-break: break-all; }
+.peer-strip .buslog:empty::before { content: "no pw_ messages yet"; color: #8b859a; }
+`;
+
+const css = (rgb) => `rgb(${rgb[0]},${rgb[1]},${rgb[2]})`;
+
+/** One bus "send" log entry as a line, or null when it is not a pw_ message. */
+export function pwLogLine(e) {
+  const d = decodePw(e.payload);
+  if (!d) return null;
+  const { type, ...rest } = d;
+  const dst = e.dst === "ff:ff:ff:ff:ff:ff" ? "*" : e.dst;
+  return `${Math.round(e.t)} ${e.src} -> ${dst} ${type} ${JSON.stringify(rest)}`;
+}
+
+export function createPeerStrip({ mount, onAdd, onRemove }) {
+  const root = document.createElement("div");
+  root.className = "peer-strip";
+  root.innerHTML = `<div class="rows" data-el="peer-rows"></div>
+    <div class="add"><button type="button" data-act="add">+ peer</button>
+    <button type="button" data-act="add-leader">+ leader</button></div>
+    <pre class="buslog" data-el="buslog"></pre>`;
+  mount.appendChild(root);
+  const rowsEl = root.querySelector('[data-el="peer-rows"]');
+  const logEl = root.querySelector('[data-el="buslog"]');
+  root.querySelector('[data-act="add"]').addEventListener("click", () => onAdd("follower"));
+  root.querySelector('[data-act="add-leader"]').addEventListener("click", () => onAdd("leader"));
+  let peers = [];
+  const lines = [];
+
+  function action(p, act) {
+    if (act === "button") p.sendMsg({ b: 1 }, 0);
+    else if (act === "drop") p.drop(!p.dropped);
+    else if (act === "start") p.start();
+    else if (act === "end") p.end();
+    else if (act === "remove") onRemove(p);
+  }
+
+  function render() {
+    rowsEl.textContent = "";
+    for (const p of peers) {
+      const row = document.createElement("div");
+      row.className = "peer-row";
+      row.dataset.peer = p.mac;
+      row.innerHTML = `<span class="swatch"></span><span class="mac"></span><span class="state"></span>
+        <span class="count"></span>
+        ${p.mode === "leader"
+          ? `<button type="button" data-act="start">start</button><button type="button" data-act="end">end</button>`
+          : `<button type="button" data-act="button">button</button>`}
+        <button type="button" data-act="drop"></button>
+        <button type="button" data-act="remove">remove</button>`;
+      row.querySelector(".swatch").style.background = css(p.identity[1]);
+      row.querySelector(".mac").textContent = p.mac;
+      row.addEventListener("click", (e) => {
+        const act = e.target.dataset?.act;
+        if (!act) return;
+        try {
+          action(p, act);
+        } catch (err) {
+          pushLog(`! ${p.mac} ${act}: ${err.message}`);
+        }
+      });
+      rowsEl.appendChild(row);
+    }
+    refresh();
+  }
+
+  function refresh() {
+    for (const p of peers) {
+      const row = rowsEl.querySelector(`[data-peer="${p.mac}"]`);
+      if (!row) continue;
+      row.querySelector(".state").textContent = `${p.mode} · ${p.dropped ? "dropped" : p.state}`;
+      row.querySelector(".count").textContent = `${p.splats.length} Splat${p.splats.length === 1 ? "" : "s"}`;
+      row.querySelector('[data-act="drop"]').textContent = p.dropped ? "back" : "drop";
+      row.classList.toggle("dropped", p.dropped);
+    }
+  }
+
+  function pushLog(line) {
+    lines.push(line);
+    if (lines.length > LOG_LIMIT) lines.splice(0, lines.length - LOG_LIMIT);
+    logEl.textContent = lines.join("\n");
+    logEl.scrollTop = logEl.scrollHeight;
+  }
+
+  return {
+    root,
+    setPeers(next) {
+      peers = next;
+      render();
+    },
+    refresh,
+    pushLog,
+    clearLog() {
+      lines.length = 0;
+      logEl.textContent = "";
+    },
+  };
+}
diff --git a/Bag3/Code/Simulator/js/panels/splat.js b/Bag3/Code/Simulator/js/panels/splat.js
new file mode 100644
index 0000000..cf0a518
--- /dev/null
+++ b/Bag3/Code/Simulator/js/panels/splat.js
@@ -0,0 +1,143 @@
+/**
+ * Splat panel for <sim-room>: every Splat in the room.
+ *
+ * The wand's own Splats come first; in a party game the virtual peers'
+ * Splats follow, each with an owner badge in that peer's identity color.
+ * A tile shows the Splat's color, its last sound or note as text, a
+ * press button (held while the pointer is down) and a link checkbox (off =
+ * the Splat drops, splat_lost). Sounds and notes also play a short tone once
+ * the page has had a click.
+ *
+ * The panel draws models (js/splats.js); the room wires them up:
+ *   setGroups([{ owner, label, rgb, splats, onButton(i, down), onReady(i, up) }])
+ *   refresh()   redraw after a model change
+ */
+
+import { noteFreq } from "../splats.js";
+
+export const SPLAT_STYLE = `
+.splat-panel { display: flex; flex-direction: column; gap: 10px; }
+.splat-group { display: flex; flex-direction: column; gap: 6px; }
+.splat-owner { font: 700 0.78rem 'Nunito', system-ui, sans-serif; color: #8b859a;
+  display: flex; align-items: center; gap: 6px; }
+.splat-owner .badge { width: 12px; height: 12px; border-radius: 50%; border: 1px solid #0002; }
+.splat-tiles { display: flex; flex-wrap: wrap; gap: 8px; }
+.splat-tile { display: flex; flex-direction: column; align-items: center; gap: 4px;
+  width: 92px; padding: 6px; border-radius: 12px; background: #f7f7fb; }
+.splat-tile .disc { width: 48px; height: 48px; border-radius: 50%; border: 2px solid #0003;
+  background: #222; transition: background 80ms; }
+.splat-tile.down .disc { transform: scale(0.92); }
+.splat-tile.lost { opacity: 0.45; }
+.splat-tile .what { font: 12px/1.2 ui-monospace, monospace; min-height: 2.4em; text-align: center;
+  word-break: break-word; }
+.splat-tile button { font: 700 0.75rem 'Nunito', system-ui, sans-serif; padding: 4px 10px;
+  border-radius: 10px; border: 1.5px solid #6c4cd1; background: #6c4cd1; color: #fff; cursor: pointer;
+  touch-action: none; }
+.splat-tile label { font-size: 0.72rem; color: #8b859a; }
+.splat-panel .empty { font-size: 0.8rem; color: #8b859a; }
+`;
+
+const css = (rgb) => `rgb(${rgb[0]},${rgb[1]},${rgb[2]})`;
+
+export function createSplatPanel({ mount }) {
+  const root = document.createElement("div");
+  root.className = "splat-panel";
+  root.dataset.el = "splat-panel";
+  mount.appendChild(root);
+  let groups = [];
+  let audio = null;
+  const heard = new WeakMap(); // splat -> last "sound|note" played
+
+  function tone(freq, ms) {
+    if (!audio) return;
+    const osc = audio.createOscillator();
+    const gain = audio.createGain();
+    osc.frequency.value = freq;
+    gain.gain.value = 0.08;
+    osc.connect(gain).connect(audio.destination);
+    osc.start();
+    osc.stop(audio.currentTime + ms / 1000);
+  }
+
+  function unlockAudio() {
+    if (audio) return;
+    const AC = window.AudioContext || window.webkitAudioContext;
+    if (AC) audio = new AC();
+  }
+
+  function sounds(splat) {
+    const key = `${splat.sound}|${splat.note}`;
+    if (heard.get(splat) === key) return;
+    heard.set(splat, key);
+    if (splat.note) tone(noteFreq(splat.note) || 262, 250);
+    else if (splat.sound) tone(330, 120);
+  }
+
+  function render() {
+    root.textContent = "";
+    if (!groups.length) {
+      root.innerHTML = `<div class="empty">no Splats</div>`;
+      return;
+    }
+    for (const g of groups) {
+      const box = document.createElement("div");
+      box.className = "splat-group";
+      box.dataset.owner = g.owner;
+      const head = document.createElement("div");
+      head.className = "splat-owner";
+      head.innerHTML = `<span class="badge"></span><span></span>`;
+      head.querySelector(".badge").style.background = css(g.rgb);
+      head.lastChild.textContent = g.label;
+      box.appendChild(head);
+      const tiles = document.createElement("div");
+      tiles.className = "splat-tiles";
+      g.splats.forEach((s, i) => {
+        const tile = document.createElement("div");
+        tile.className = "splat-tile";
+        tile.dataset.splat = s.mac;
+        tile.innerHTML = `<div class="disc"></div><div class="what"></div>
+          <button type="button">press</button>
+          <label><input type="checkbox"> link</label>`;
+        const btn = tile.querySelector("button");
+        btn.addEventListener("pointerdown", (e) => {
+          unlockAudio();
+          btn.setPointerCapture?.(e.pointerId);
+          g.onButton(i, true);
+        });
+        const up = () => { if (s.pressed) g.onButton(i, false); };
+        btn.addEventListener("pointerup", up);
+        btn.addEventListener("pointercancel", up);
+        tile.querySelector("input").addEventListener("change", (e) => g.onReady(i, e.target.checked));
+        tiles.appendChild(tile);
+      });
+      box.appendChild(tiles);
+      root.appendChild(box);
+    }
+    refresh();
+  }
+
+  function refresh() {
+    for (const g of groups) {
+      g.splats.forEach((s) => {
+        const tile = root.querySelector(`[data-splat="${s.mac}"]`);
+        if (!tile) return;
+        tile.querySelector(".disc").style.background = css(s.rgb);
+        const what = [s.color, s.sound, s.note].filter(Boolean).join(" · ");
+        tile.querySelector(".what").textContent = what || "off";
+        tile.querySelector("input").checked = s.ready;
+        tile.classList.toggle("lost", !s.ready);
+        tile.classList.toggle("down", s.pressed);
+        sounds(s);
+      });
+    }
+  }
+
+  return {
+    root,
+    setGroups(next) {
+      groups = next;
+      render();
+    },
+    refresh,
+  };
+}
diff --git a/Bag3/Code/Simulator/js/peers.js b/Bag3/Code/Simulator/js/peers.js
new file mode 100644
index 0000000..0ace2f1
--- /dev/null
+++ b/Bag3/Code/Simulator/js/peers.js
@@ -0,0 +1,457 @@
+/**
+ * Virtual peers: JS wands that take part in a party game's pw_* protocol
+ * (SPEC sections 6-8, MockWand/lib/party.py) beside the simulated wand.
+ *
+ * A peer runs no game code. A "follower" peer does what party.py's follower
+ * side does: finds the lobby (pw_find), joins on pw_lobby (pw_join, resent
+ * every JOIN_WAIT_MS up to SEND_TRIES), waits for pw_start, then heartbeats
+ * (pw_hb with its ready-Splat bitmask), runs pooled pw_cmd on its own
+ * Splats, forwards Splat presses as pw_evt, and leaves (pw_leave) or ends
+ * on pw_end. Incoming pw_msg goes to `respond(data, fromWand, peer)`; a
+ * non-null return is sent back to that wand. A "leader" peer covers only the
+ * lobby (pw_lobby, pw_joined), pw_start, heartbeats and pw_end, so the
+ * simulated wand's follower path can be exercised.
+ *
+ * Every unicast carries a fresh "q" and repeated q's from a sender are
+ * dropped, as in party.Link. A peer sends each frame once: the bus gives a
+ * JS peer no ACK to retry on.
+ *
+ * drop(true) silences the peer (nothing sent or received; its timers keep
+ * running), which is what tests wand_lost on the simulated wand.
+ *
+ * tests/js/peers.test.mjs replays MockWand/tests/transcripts/*.json against
+ * the follower side.
+ */
+
+import { BROADCAST, normalizeMac } from "./bus.js";
+import { createSplat } from "./splats.js";
+
+/** party.py timing; tests/js/peers.test.mjs checks it against the transcripts. */
+export const PW = {
+  FIND_WAIT_MS: 500,
+  LOBBY_PERIOD_MS: 1000,
+  HB_PERIOD_MS: 1000,
+  WAND_LOST_MS: 3000,
+  SEND_TRIES: 3,
+  JOIN_WAIT_MS: 500,
+};
+
+export const OPS = ["color", "sound", "note", "play", "off"];
+
+/** pairing.IDENTITY: [Splat color name, wand matrix RGB]. */
+export const IDENTITY = [
+  ["turnred", [130, 0, 0]],
+  ["turngreen", [0, 230, 0]],
+  ["turnblue", [0, 20, 255]],
+  ["turnpurple", [50, 0, 250]],
+  ["turnyellow", [110, 120, 0]],
+  ["turnwhite", [140, 150, 150]],
+];
+
+/** pairing.identity(mac): indexed by the MAC's last byte. */
+export function identity(mac) {
+  return IDENTITY[parseInt(String(mac).slice(-2), 16) % IDENTITY.length];
+}
+
+const enc = new TextEncoder();
+const dec = new TextDecoder();
+
+/** A bus payload as a pw_ message object, or null. */
+export function decodePw(payload) {
+  let d;
+  try {
+    d = JSON.parse(typeof payload === "string" ? payload : dec.decode(payload));
+  } catch {
+    return null;
+  }
+  if (!d || typeof d !== "object" || Array.isArray(d)) return null;
+  return String(d.type || "").startsWith("pw_") ? d : null;
+}
+
+let gameCounter = 0;
+
+/**
+ * opts:
+ *   mac        this peer's MAC
+ *   clock      { nowMs() }
+ *   transport  (dstMacUpper | "*", msgObject) => void; attachPeer() sets it
+ *   splats     number of Splats this peer holds (default 1)
+ *   mode       "follower" (default) | "leader"
+ *   respond    (data, fromWand, peer) => reply data | null, for pw_msg
+ *   exitOn     game events after which the peer's "game" exits and closes
+ *              (default ["end", "leader_lost"])
+ *   onChange   (peer) => void after any state change
+ */
+export function createPeer(opts) {
+  const mac = normalizeMac(opts.mac).toUpperCase();
+  const clock = opts.clock;
+  const exitOn = opts.exitOn || ["end", "leader_lost"];
+  const p = {
+    mac,
+    mode: opts.mode || "follower",
+    identity: identity(mac),
+    state: "idle",
+    slug: null,
+    id: null,
+    leader: null,
+    dropped: false,
+    respond: opts.respond || null,
+    transport: opts.transport || null,
+    onChange: opts.onChange || null,
+    /** Net events, oldest first, as party.Net.poll() returns them. */
+    events: [],
+    /** Things party.py would print: bad pw_cmd, unknown actions. */
+    log: [],
+    // follower lobby / net
+    wands: [],
+    pool: [],
+    me: null,
+    // leader
+    roster: [],
+    smin: 1,
+    smax: null,
+  };
+  p.splats = [];
+  for (let i = 0; i < (opts.splats ?? 1); i++) {
+    p.splats.push(createSplat({ mac: splatMac(mac, i), owner: mac, onChange: () => changed() }));
+  }
+
+  let q = 0;
+  let seen = {};
+  let t = 0;
+  let tries = 0;
+  let hbT = 0;
+  let seenLeader = 0;
+  let lost = false;
+  let ended = false;
+  let seenWand = [];
+
+  const now = () => clock.nowMs();
+  const expired = (since, ms) => now() - since >= ms;
+  function changed() { p.onChange?.(p); }
+
+  function out(dst, msg) {
+    if (p.dropped || !p.transport) return;
+    p.transport(dst, msg);
+  }
+  function broadcast(msg) { out("*", msg); }
+  function send(dst, msg) {
+    q += 1;
+    out(dst, { ...msg, q });
+  }
+
+  function event(ev) {
+    p.events.push(ev);
+    if (exitOn.includes(ev[0])) p.close();
+  }
+
+  function readyBits() {
+    let bits = 0;
+    p.splats.forEach((s, i) => { if (s.ready) bits |= 1 << i; });
+    return bits;
+  }
+
+  function poolIndex(w, s) {
+    return p.pool.findIndex((e) => e[0] === w && e[1] === s);
+  }
+
+  function resetLink() {
+    q = 0;
+    seen = {};
+  }
+
+  // ── follower ────────────────────────────────
+
+  function join(src, gid) {
+    p.state = "join";
+    p.leader = src;
+    p.id = gid;
+    tries = 1;
+    t = now();
+    send(src, { type: "pw_join", id: gid, splats: p.splats.length });
+  }
+
+  function refind() {
+    p.state = "find";
+    p.id = null;
+    p.leader = null;
+    t = now();
+    broadcast({ type: "pw_find", g: p.slug });
+  }
+
+  function startNet(d) {
+    p.wands = (d.wands || []).map((w) => [String(w[0]).toUpperCase(), Number(w[1])]);
+    p.pool = (d.pool || []).map((e) => [e[0], e[1]]);
+    p.me = p.wands.findIndex((w) => w[0] === mac);
+    if (p.me < 0) throw new Error(`pw_start without this peer (${mac}) in wands`);
+    p.state = "game";
+    ended = false;
+    lost = false;
+    hbT = now() - PW.HB_PERIOD_MS;
+    seenLeader = now();
+  }
+
+  function runCmd(d) {
+    const s = d.s;
+    if (!OPS.includes(d.op) || !Number.isInteger(s) || s < 0 || s >= p.splats.length) {
+      p.log.push(`bad pw_cmd ${JSON.stringify(d)}`);
+      return;
+    }
+    try {
+      p.splats[s].applyAction(d.op, d.v);
+    } catch (err) {
+      p.log.push(`pw_cmd ${d.op} ${JSON.stringify(d.v)}: ${err.message}`);
+    }
+  }
+
+  function followerHandle(d, src) {
+    const ty = d.type;
+    if (p.state === "find") {
+      if (ty === "pw_lobby" && d.g === p.slug) join(src, d.id);
+      return;
+    }
+    if (p.state === "join" || p.state === "member") {
+      if (src !== p.leader || d.id !== p.id) return;
+      if (ty === "pw_lobby") t = now();
+      else if (ty === "pw_joined" && p.state === "join") {
+        p.state = "member";
+        t = now();
+      } else if (ty === "pw_start") startNet(d);
+      else if (ty === "pw_end") {
+        if (d.r === "merge") refind();
+        else p.state = "idle";
+      }
+      return;
+    }
+    if (p.state !== "game") return;
+    const w = p.wands.findIndex((x) => x[0] === src);
+    if (d.id !== p.id || w < 0) return;
+    if (w === 0) {
+      seenLeader = now();
+      lost = false;
+    }
+    if (ty === "pw_msg") {
+      event(["msg", w, d.d]);
+      if (p.respond && p.state === "game") {
+        const reply = p.respond(d.d, w, p);
+        if (reply != null) p.sendMsg(reply, w);
+      }
+    } else if (w === 0 && ty === "pw_cmd") runCmd(d);
+    else if (w === 0 && ty === "pw_end") {
+      ended = true;
+      event(["end"]);
+    }
+  }
+
+  function followerTick() {
+    if (p.state === "join" && expired(t, PW.JOIN_WAIT_MS)) {
+      if (tries >= PW.SEND_TRIES) {
+        refind();
+        return;
+      }
+      tries += 1;
+      t = now();
+      send(p.leader, { type: "pw_join", id: p.id, splats: p.splats.length });
+    } else if (p.state === "member" && expired(t, PW.WAND_LOST_MS)) {
+      p.state = "idle";
+      event(["leader_lost"]);
+    } else if (p.state === "game") {
+      if (expired(hbT, PW.HB_PERIOD_MS)) {
+        hbT = now();
+        broadcast({ type: "pw_hb", id: p.id, l: readyBits() });
+      }
+      if (!ended && !lost && expired(seenLeader, PW.WAND_LOST_MS)) {
+        lost = true;
+        event(["leader_lost"]);
+      }
+    }
+  }
+
+  // ── leader ──────────────────────────────────
+
+  function lobbyMsg() {
+    const n = p.roster.reduce((a, r) => a + r[1], 0);
+    return { type: "pw_lobby", g: p.slug, id: p.id, n, min: p.smin, max: p.smax };
+  }
+
+  function first(m) {
+    let n = 0;
+    for (const [rm, c] of p.roster) {
+      if (rm === m) return n;
+      n += c;
+    }
+    return null;
+  }
+
+  function leaderHandle(d, src) {
+    const ty = d.type;
+    if (p.state === "lead") {
+      if (ty === "pw_find" && d.g === p.slug) send(src, lobbyMsg());
+      else if (ty === "pw_join" && d.id === p.id) {
+        if (first(src) === null) p.roster.push([src, Number(d.splats) || 0]);
+        send(src, { type: "pw_joined", id: p.id, first: first(src), wands: p.roster.length });
+      } else if (ty === "pw_leave" && d.id === p.id) {
+        p.roster = p.roster.filter((r) => r[0] !== src);
+      }
+      return;
+    }
+    if (p.state !== "lead_game" || d.id !== p.id) return;
+    const w = p.wands.findIndex((x) => x[0] === src);
+    if (w < 0) return;
+    seenWand[w] = now();
+    if (ty === "pw_evt") event([d.e ? "press" : "release", d.s]);
+    else if (ty === "pw_msg") event(["msg", w, d.d]);
+    else if (ty === "pw_leave") event(["wand_lost", w]);
+  }
+
+  function leaderTick() {
+    if (p.state === "lead" && expired(t, PW.LOBBY_PERIOD_MS)) {
+      t = now();
+      broadcast(lobbyMsg());
+    } else if (p.state === "lead_game" && expired(hbT, PW.HB_PERIOD_MS)) {
+      hbT = now();
+      broadcast({ type: "pw_hb", id: p.id, l: readyBits() });
+    }
+  }
+
+  // ── public ──────────────────────────────────
+
+  /** A tap of the game's card: find (follower) or open a lobby (leader). */
+  p.tap = (slug, { smin = 1, smax = null } = {}) => {
+    resetLink();
+    p.slug = slug;
+    p.events = [];
+    p.wands = [];
+    p.pool = [];
+    p.me = null;
+    if (p.mode === "leader") {
+      gameCounter = (gameCounter + 1) & 0xff;
+      p.id = mac.slice(-5).replace(":", "") + gameCounter.toString(16).toUpperCase().padStart(2, "0");
+      p.smin = smin;
+      p.smax = smax;
+      p.roster = [[mac, p.splats.length]];
+      p.state = "lead";
+      t = now();
+      broadcast(lobbyMsg());
+    } else {
+      refind();
+    }
+    changed();
+  };
+
+  /** Bus input: src MAC (any case), payload bytes or text. */
+  p.receive = (src, payload) => {
+    if (p.dropped) return;
+    const d = decodePw(payload);
+    if (!d) return;
+    const from = normalizeMac(src).toUpperCase();
+    if (d.q !== undefined && d.q !== null) {
+      const last = seen[from];
+      if (last !== undefined && d.q <= last) return;
+      seen[from] = d.q;
+    }
+    if (p.mode === "leader") leaderHandle(d, from);
+    else followerHandle(d, from);
+    changed();
+  };
+
+  p.tick = () => {
+    const before = p.state;
+    if (p.mode === "leader") leaderTick();
+    else followerTick();
+    if (p.state !== before) changed();
+  };
+
+  /** Leader peer: start the game with everyone in the lobby. */
+  p.start = () => {
+    if (p.mode !== "leader" || p.state !== "lead") throw new Error("start(): not a leader in its lobby");
+    p.pool = [];
+    p.roster.forEach(([, c], w) => { for (let s = 0; s < c; s++) p.pool.push([w, s]); });
+    p.wands = p.roster.map(([m, c]) => [m, c]);
+    for (const [m] of p.wands.slice(1)) {
+      send(m, { type: "pw_start", id: p.id, wands: p.wands, pool: p.pool });
+    }
+    p.me = 0;
+    p.state = "lead_game";
+    hbT = now() - PW.HB_PERIOD_MS;
+    seenWand = p.wands.map(() => now());
+    changed();
+  };
+
+  /** Leader peer: end the lobby or game for everyone (pw_end). */
+  p.end = () => {
+    if (p.mode !== "leader") throw new Error("end(): not a leader");
+    const members = p.state === "lead" ? p.roster.slice(1).map((r) => r[0])
+      : p.wands.slice(1).map((w) => w[0]);
+    for (const m of members) send(m, { type: "pw_end", id: p.id });
+    for (const s of p.splats) s.applyAction("off");
+    p.state = "idle";
+    changed();
+  };
+
+  /** A press (down=true) or release on this peer's Splat s. */
+  p.splatButton = (s, down) => {
+    const splat = p.splats[s];
+    splat.setPressed(down);
+    if (p.state === "game" && !ended) {
+      const i = poolIndex(p.me, s);
+      if (i >= 0) send(p.wands[0][0], { type: "pw_evt", id: p.id, s: i, e: down ? 1 : 0 });
+    } else if (p.state === "lead_game") {
+      const i = poolIndex(0, s);
+      if (i >= 0) event([down ? "press" : "release", i]);
+    }
+  };
+
+  p.setSplatReady = (s, up) => p.splats[s].setReady(up);
+
+  /** net.send(): a pw_msg to wand `to` (default the leader), or to all with null. */
+  p.sendMsg = (data, to = 0) => {
+    if (p.state !== "game" && p.state !== "lead_game") throw new Error("sendMsg(): not in a game");
+    const targets = to === null ? p.wands.map((_, i) => i) : [to];
+    for (const w of targets) {
+      if (w !== p.me) send(p.wands[w][0], { type: "pw_msg", id: p.id, d: data });
+    }
+  };
+
+  /** The peer's game exits: net.close() (pw_leave unless ended), Splats off. */
+  p.close = () => {
+    if (p.state === "game") {
+      if (!ended) send(p.wands[0][0], { type: "pw_leave", id: p.id });
+      for (const s of p.splats) s.applyAction("off");
+    } else if (p.state === "join" || p.state === "member") {
+      send(p.leader, { type: "pw_leave", id: p.id });
+    }
+    p.state = "idle";
+    changed();
+  };
+
+  p.drop = (on) => {
+    p.dropped = !!on;
+    changed();
+  };
+
+  return p;
+}
+
+export function splatMac(ownerMac, i) {
+  const last = normalizeMac(ownerMac).slice(-2).toUpperCase();
+  return `5A:00:00:00:${last}:${i.toString(16).toUpperCase().padStart(2, "0")}`;
+}
+
+/**
+ * Put a peer on a bus (js/bus.js): its frames go out as JSON, the bus
+ * delivers to receive(). With tickMs, tick() runs on a real-time interval.
+ * Returns detach().
+ */
+export function attachPeer(bus, peer, { tickMs = 10 } = {}) {
+  const detachBus = bus.attach(peer.mac, (src, payload) => peer.receive(src, payload));
+  peer.transport = (dst, msg) => {
+    bus.send(peer.mac, dst === "*" ? BROADCAST : dst, enc.encode(JSON.stringify(msg)));
+  };
+  const timer = tickMs ? setInterval(() => peer.tick(), tickMs) : null;
+  return () => {
+    if (timer !== null) clearInterval(timer);
+    peer.transport = null;
+    detachBus();
+  };
+}
