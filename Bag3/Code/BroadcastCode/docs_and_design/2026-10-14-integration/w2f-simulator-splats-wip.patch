diff --git a/Bag3/Code/Simulator/tests/js/peers.test.mjs b/Bag3/Code/Simulator/tests/js/peers.test.mjs
new file mode 100644
index 0000000..26bf950
--- /dev/null
+++ b/Bag3/Code/Simulator/tests/js/peers.test.mjs
@@ -0,0 +1,237 @@
+// Virtual peers (js/peers.js) against MockWand/tests/transcripts/*.json.
+// Run: node --test tests/js/*.test.mjs
+//
+// Each follower wand X in a transcript is replaced by a JS peer. The peer is
+// fed every frame delivered to X at its recorded time, plus the stimuli the
+// transcript implies (tap at X's first pw_find, Splat presses from X's
+// pw_evt, pw_msg / pw_leave from the game, Splat readiness from X's pw_hb
+// bits, a drop window where X's heartbeats are missing). Its frames must
+// equal X's recorded frames: same type, destination, fields and q, with
+// link-level retries (same q repeated) collapsed.
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync, readdirSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { createPeer, attachPeer, PW, IDENTITY, identity } from "../../js/peers.js";
+import { COLOR_RGB, NOTE_VALUES, ANIMAL_SOUNDS, createSplat } from "../../js/splats.js";
+import { createBus } from "../../js/bus.js";
+import { createClock } from "../../js/clock.js";
+import * as splatActions from "../../../BroadcastCode/ChatBroadcast/js/splat/splatActions.js";
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const TRANSCRIPTS = join(HERE, "..", "..", "..", "BroadcastCode", "MockWand", "tests", "transcripts");
+const STEP = 10;
+
+// The leader peer is not modelled for the merge of two leaders.
+const SKIP = { simultaneous_leaders: "B leads, then merges: leader side, not a follower peer" };
+
+function load(name) {
+  return JSON.parse(readFileSync(join(TRANSCRIPTS, name), "utf8"));
+}
+
+/** X's sent frames with link retries (same dst and q in a row) collapsed. */
+function sentBy(doc, x) {
+  const out = [];
+  for (const f of doc.frames) {
+    if (f.src !== x) continue;
+    const prev = out[out.length - 1];
+    if (prev && f.msg.q !== undefined && prev.dst === f.dst && prev.msg.q === f.msg.q) continue;
+    out.push({ t: f.t, dst: f.dst, msg: f.msg });
+  }
+  return out;
+}
+
+function deliveredTo(f, x) {
+  if (f.dst === "*") return Array.isArray(f.delivered) && f.delivered.includes(x);
+  return f.dst === x && f.delivered === true;
+}
+
+/** Stimuli implied by X's own frames: [{t, pre?, fn(peer)}]. */
+function stimuli(doc, x, sent) {
+  const st = [];
+  const first = sent.find((f) => f.msg.type === "pw_find");
+  const slug = first.msg.g;
+  st.push({ t: first.t, pre: true, fn: (p) => p.tap(slug) });
+  const hbs = sent.filter((f) => f.msg.type === "pw_hb");
+  for (let i = 0; i < hbs.length; i++) {
+    const h = hbs[i];
+    st.push({ t: h.t, pre: true, fn: (p) => p.splats.forEach((s, k) => {
+      const up = !!(h.msg.l & (1 << k));
+      if (s.ready !== up) s.setReady(up);
+    }) });
+    const next = hbs[i + 1];
+    if (next && next.t - h.t > 1.5 * PW.HB_PERIOD_MS) {
+      st.push({ t: h.t + STEP, pre: true, fn: (p) => p.drop(true) });
+      st.push({ t: next.t - STEP, pre: true, fn: (p) => p.drop(false) });
+    }
+  }
+  for (const f of sent) {
+    const m = f.msg;
+    if (m.type === "pw_evt") {
+      st.push({ t: f.t, fn: (p) => {
+        const [w, s] = p.pool[m.s];
+        assert.equal(w, p.me, "pw_evt for a pool Splat this wand holds");
+        p.splatButton(s, !!m.e);
+      } });
+    } else if (m.type === "pw_msg") {
+      st.push({ t: f.t, fn: (p) => p.sendMsg(m.d, p.wands.findIndex((w) => w[0] === f.dst)) });
+    } else if (m.type === "pw_leave") {
+      st.push({ t: f.t, fn: (p) => p.close() });
+    }
+  }
+  return st;
+}
+
+function replay(doc, x) {
+  const clock = createClock({ manual: true });
+  const out = [];
+  const received = [];
+  const leaderLostDropped = doc.scenario === "wand_lost_back";
+  const peer = createPeer({
+    mac: x, clock, splats: doc.splats[Object.keys(doc.wands).find((k) => doc.wands[k] === x)],
+    transport: (dst, msg) => out.push({ t: clock.nowMs(), dst, msg }),
+    respond: (d, w) => { received.push([w, d]); return null; },
+    // The transcript harness runs no game, so nothing exits on leader_lost.
+    exitOn: leaderLostDropped ? ["end"] : undefined,
+  });
+  const sent = sentBy(doc, x);
+  const st = stimuli(doc, x, sent);
+  const end = doc.frames[doc.frames.length - 1].t;
+  for (let t = 0; t <= end; t += STEP) {
+    clock.advance(t - clock.nowMs());
+    for (const s of st) if (s.pre && s.t === t) s.fn(peer);
+    peer.tick();
+    for (const f of doc.frames) {
+      if (f.t === t && deliveredTo(f, x)) peer.receive(f.src, JSON.stringify(f.msg));
+    }
+    for (const s of st) if (!s.pre && s.t === t) s.fn(peer);
+  }
+  return { peer, out, sent, received };
+}
+
+const strip = (frames) => frames.map((f) => ({ dst: f.dst, msg: f.msg }));
+
+const files = readdirSync(TRANSCRIPTS).filter((f) => f.endsWith(".json")).sort();
+
+test("transcripts exist and use party.py's timing", () => {
+  assert.ok(files.length >= 10, `transcripts in ${TRANSCRIPTS}`);
+  for (const f of files) {
+    const doc = load(f);
+    assert.equal(doc.format, "pw-transcript/1");
+    for (const [k, v] of Object.entries(PW)) assert.equal(doc.constants[k], v, `${f} ${k}`);
+  }
+});
+
+for (const f of files) {
+  const doc = load(f);
+  const leader = doc.frames[0].src;
+  const followers = Object.values(doc.wands).filter((m) => m !== leader
+    && doc.frames.some((fr) => fr.src === m));
+  for (const x of followers) {
+    const label = Object.keys(doc.wands).find((k) => doc.wands[k] === x);
+    test(`${doc.scenario}: peer as ${label} sends what party.py sent`, { skip: SKIP[doc.scenario] }, () => {
+      const { peer, out, sent, received } = replay(doc, x);
+      assert.deepEqual(strip(out), strip(sent));
+      const cmds = doc.frames.filter((fr) => fr.dst === x && fr.msg.type === "pw_cmd" && fr.delivered);
+      const qs = [...new Set(cmds.map((fr) => fr.msg.q))];
+      if (doc.scenario === "duplicate_q") {
+        assert.equal(peer.splats[0].history.length, qs.length, "each q runs once");
+      }
+      if (doc.scenario === "pooled_commands" && label === "B") {
+        assert.deepEqual(peer.splats[0].history, [["color", "turnblue"], ["off", null]]);
+        assert.deepEqual(peer.splats[0].rgb, [0, 0, 0]);
+      }
+      if (doc.scenario === "pooled_commands" && label === "C") {
+        assert.deepEqual(peer.splats[0].rgb, [255, 0, 0]);
+        assert.equal(peer.splats[0].sound, "cat");
+      }
+      if (doc.scenario === "messages") {
+        const msgs = doc.frames.filter((fr) => fr.dst === x && fr.msg.type === "pw_msg");
+        assert.deepEqual(received, msgs.map((fr) => [0, fr.msg.d]));
+      }
+      if (["leader_end", "follower_error_leave"].includes(doc.scenario) && peer.events.some((e) => e[0] === "end")) {
+        assert.equal(peer.state, "idle");
+        assert.deepEqual(peer.splats[0].history.at(-1), ["off", undefined]);
+      }
+      if (doc.scenario === "wand_lost_back" && label === "C") {
+        assert.deepEqual(peer.events, [["leader_lost"]]);
+      }
+    });
+  }
+}
+
+test("splats.js vocabulary matches the generated splatActions.js", () => {
+  assert.deepEqual(Object.keys(COLOR_RGB).sort(), [...splatActions.COLORS].sort());
+  assert.deepEqual(Object.keys(NOTE_VALUES).sort(), [...splatActions.NOTES].sort());
+  assert.deepEqual(Object.keys(ANIMAL_SOUNDS).sort(), [...splatActions.SOUNDS].sort());
+});
+
+test("Splat model: BLE writes from the wand's own Splats", () => {
+  const s = createSplat({ mac: "5A:00:00:00:01:00" });
+  s.applyWrite("leds", [160, 0, 200]);
+  assert.equal(s.color, "turnpurple");
+  s.applyWrite("sound", [21]);
+  assert.equal(s.sound, "cow");
+  s.applyWrite("noteOn", [4, 4]);
+  assert.equal(s.note, "note_e");
+  s.applyWrite("tasksOff", []);
+  s.applyWrite("ledsOff", []);
+  assert.deepEqual([s.rgb, s.sound, s.note], [[0, 0, 0], null, null]);
+  assert.throws(() => s.applyAction("color", "turnpink"));
+});
+
+test("identity() follows pairing.IDENTITY", () => {
+  assert.equal(identity("AA:00:00:00:00:01")[0], "turngreen");
+  assert.equal(identity("AA:00:00:00:00:06")[0], IDENTITY[0][0]);
+});
+
+test("leader peer and follower peer play a game over the bus", () => {
+  const clock = createClock({ manual: true });
+  const bus = createBus({ clock, autoRun: false, settings: { latencyMs: 0 } });
+  const lead = createPeer({ mac: "02:00:00:00:01:01", clock, mode: "leader" });
+  const fol = createPeer({ mac: "02:00:00:00:0b:01", clock, splats: 2 });
+  attachPeer(bus, lead, { tickMs: 0 });
+  attachPeer(bus, fol, { tickMs: 0 });
+  const run = (ms) => {
+    for (let i = 0; i < ms; i += STEP) {
+      clock.advance(STEP);
+      lead.tick();
+      fol.tick();
+      bus.pump();
+    }
+  };
+  lead.tap("partytest", { smin: 2 });
+  fol.tap("partytest");
+  run(1100);
+  assert.equal(fol.state, "member");
+  assert.deepEqual(lead.roster.map((r) => r[1]), [1, 2]);
+  lead.start();
+  run(50);
+  assert.equal(fol.state, "game");
+  assert.deepEqual(fol.pool, [[0, 0], [1, 0], [1, 1]]);
+  fol.splatButton(1, true);
+  run(20);
+  assert.deepEqual(lead.events.at(-1), ["press", 2]);
+  lead.end();
+  run(20);
+  assert.deepEqual(fol.events, [["end"]]);
+  assert.equal(fol.state, "idle");
+  // A dropped follower hears nothing: leader_lost, and its game exits.
+  lead.tap("partytest", { smin: 2 });
+  fol.tap("partytest");
+  run(1100);
+  lead.start();
+  run(50);
+  fol.drop(true);
+  run(PW.WAND_LOST_MS + 100);
+  assert.deepEqual(fol.events, [["leader_lost"]]);
+  assert.equal(fol.state, "idle");
+  const types = bus.log.filter((e) => e.event === "send")
+    .map((e) => JSON.parse(new TextDecoder().decode(e.payload)).type);
+  for (const t of ["pw_find", "pw_lobby", "pw_join", "pw_joined", "pw_start", "pw_hb", "pw_evt", "pw_end"]) {
+    assert.ok(types.includes(t), `bus log has ${t}`);
+  }
+});
diff --git a/Bag3/Code/Simulator/tests/test_splats_net.py b/Bag3/Code/Simulator/tests/test_splats_net.py
new file mode 100644
index 0000000..938390f
--- /dev/null
+++ b/Bag3/Code/Simulator/tests/test_splats_net.py
@@ -0,0 +1,213 @@
+"""
+Fake Splats (py/shims/sim_splats.py) under the real pairing / splat_api, and
+the `net` runtime._run_play passes by play()'s arity (integration PLAN 5.6,
+5.7).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+
+import pytest
+
+WAND = "02:00:00:00:0a:01"
+LEADER = "02:00:00:00:01:01"
+
+
+async def _until(pred, timeout=3.0, step=0.01):
+    loop = asyncio.get_event_loop()
+    end = loop.time() + timeout
+    while loop.time() < end:
+        if pred():
+            return True
+        await asyncio.sleep(step)
+    return pred()
+
+
+@pytest.fixture
+def splats(runtime):
+    import sim_splats
+    writes = []
+    sim_splats.set_write_callback(lambda i, op, args: writes.append((i, op, tuple(args))))
+    yield sim_splats, writes
+    sim_splats.set_write_callback(None)
+    sim_splats.ensure(0)
+
+
+@pytest.fixture
+def radio(runtime):
+    """The wand on a capture bus: sent frames as (dst, decoded JSON)."""
+    sent = []
+
+    def tx(src, dst, hexs):
+        payload = bytes.fromhex(hexs)
+        try:
+            sent.append((dst, json.loads(payload)))
+        except ValueError:
+            sent.append((dst, payload))
+        return 1
+
+    runtime.sim_state.set_own_mac(WAND)
+    runtime.sim_state.set_radio_tx(tx)
+    yield sent
+    runtime.sim_state.set_radio_tx(None)
+
+
+def _inject(rt, src, msg):
+    rt.sim_state.deliver_enow(src, json.dumps(msg).encode())
+
+
+def _types(sent, dst=None):
+    return [m.get("type") for d, m in sent
+            if isinstance(m, dict) and (dst is None or d == dst)]
+
+
+def test_fake_splats_under_real_libs(runtime, splats):
+    sim_splats, writes = splats
+    import pairing
+    ls = sim_splats.ensure(2, "02:00:00:00:0A:01")
+    assert pairing.local() is ls
+    assert ls.count == 2 and ls.ready() == [0, 1]
+    assert ls.macs == ["5A:00:00:00:01:00", "5A:00:00:00:01:01"]
+    assert ls.splat(1).color("turnred") is True
+    assert writes[-1] == (1, "leds", (255, 0, 0))
+    ls.splat(0).play(["cat", "note_e"])
+    assert (0, "sound", (19,)) in writes and (0, "noteOn", (4, 4)) in writes
+    sim_splats.press(1)
+    assert ls.poll() == ("press", 1)
+    sim_splats.release(1)
+    assert ls.poll() == ("release", 1)
+    sim_splats.set_ready(0, False)
+    assert ls.poll() == ("splat_lost", 0)
+    assert ls.ready() == [1]
+    assert sim_splats.ensure(2) is ls          # same count: reused
+    assert sim_splats.ensure(0) is None and pairing.local() is None
+
+
+def test_local_splat_count(runtime):
+    rt = runtime
+    rt.load_game("solotest")
+    assert rt.local_splat_count() == 1
+    rt.load_game("partytest")
+    assert rt.local_splat_count() == 1
+    rt.load_game("jump")
+    assert rt.local_splat_count() == 0
+    rt.set_local_splats(3)
+    assert rt.local_splat_count() == 3
+    rt.set_local_splats(None)
+
+
+ARITY_SRC = '''
+SPLATS_LOCAL = 1
+GOT = []
+
+def play(nfc, leds, buz, accel, i2c, enow, batt=None, net=None):
+    GOT.append(net)
+    net.splat(0).color("turngreen")
+'''
+
+SIX_SRC = '''
+GOT = []
+
+def play(nfc, leds, buz, accel, i2c, enow):
+    GOT.append(enow)
+'''
+
+
+async def test_solo_game_gets_solonet(runtime, splats):
+    sim_splats, writes = splats
+    rt = runtime
+    rt.load_game(ARITY_SRC)
+    task = await rt.start()
+    await task
+    net = rt._game_mod.GOT[0]
+    assert type(net).__name__ == "SoloNet"
+    assert net.splat_count == 1 and net.is_leader
+    assert (0, "leds", (0, 255, 0)) in writes
+    assert writes[-1] == (0, "ledsOff", ())        # net.close() after play()
+
+
+async def test_six_arg_game_without_net(runtime, splats):
+    rt = runtime
+    rt.load_game(SIX_SRC)
+    task = await rt.start()
+    await task
+    assert type(rt._game_mod.GOT[0]).__name__ == "ESPNowManager"
+    assert rt.net is None
+
+
+async def test_solo_refused_without_ready_splat(runtime, splats):
+    sim_splats, _ = splats
+    rt = runtime
+    rt.set_local_splats(1)
+    sim_splats.ensure(1)
+    sim_splats.set_ready(0, False)
+    rt.load_game(ARITY_SRC)
+    task = await rt.start()
+    await task
+    assert rt._game_mod.GOT == []
+    sim_splats.set_ready(0, True)
+    rt.set_local_splats(None)
+
+
+async def test_solotest_press_cycles_identity(runtime, splats):
+    sim_splats, writes = splats
+    rt = runtime
+    rt.load_game("solotest")
+    await rt.start()
+    assert await _until(lambda: (0, "leds", (255, 0, 0)) in writes)   # IDENTITY[0]
+    sim_splats.press(0)        # splat_api reports only the latest edge per poll
+    assert await _until(lambda: (0, "leds", (0, 255, 0)) in writes)   # IDENTITY[1]
+    sim_splats.release(0)
+    await rt.stop()
+
+
+async def test_partytest_leader_alone(runtime, splats, radio):
+    """No other wand: the lobby leads after FIND_WAIT_MS, a button press
+    starts it with the wand's own Splat, a Splat press lights it."""
+    sim_splats, writes = splats
+    rt = runtime
+    rt.load_game("partytest")
+    await rt.start()
+    assert await _until(lambda: "pw_lobby" in _types(radio))
+    rt.sim_state.set_button(True)
+    await asyncio.sleep(0.05)
+    rt.sim_state.set_button(False)
+    assert await _until(lambda: "pw_hb" in _types(radio))
+    assert rt.net is not None and rt.net.is_leader
+    sim_splats.press(0)
+    # Wand MAC ends in 01 -> IDENTITY[1] turngreen.
+    assert await _until(lambda: (0, "leds", (0, 255, 0)) in writes)
+    await rt.stop()
+
+
+async def test_partytest_follower(runtime, splats, radio):
+    """A scripted leader: the wand joins, runs the pooled pw_cmd on its own
+    Splat and returns on pw_end without sending pw_leave."""
+    sim_splats, writes = splats
+    rt = runtime
+    rt.load_game("partytest")
+    await rt.start()
+    assert await _until(lambda: "pw_find" in _types(radio))
+    _inject(rt, LEADER, {"type": "pw_lobby", "g": "partytest", "id": "L1", "n": 0,
+                         "min": 1, "max": None})
+    assert await _until(lambda: "pw_join" in _types(radio, LEADER))
+    join = [m for d, m in radio if d == LEADER][-1]
+    assert join["splats"] == 1 and join["id"] == "L1"
+    W = WAND.upper()
+    L = LEADER.upper()
+    _inject(rt, LEADER, {"type": "pw_joined", "id": "L1", "first": 0, "wands": 2, "q": 1})
+    _inject(rt, LEADER, {"type": "pw_start", "id": "L1", "wands": [[L, 0], [W, 1]],
+                         "pool": [[1, 0]], "q": 2})
+    assert await _until(lambda: rt.net is not None)
+    assert rt.net.is_leader is False and rt.net.me == 1
+    _inject(rt, LEADER, {"type": "pw_cmd", "id": "L1", "s": 0, "op": "color",
+                         "v": "turnpurple", "q": 3})
+    assert await _until(lambda: (0, "leds", (160, 0, 200)) in writes)
+    sim_splats.press(0)
+    assert await _until(lambda: "pw_evt" in _types(radio, LEADER))
+    _inject(rt, LEADER, {"type": "pw_end", "id": "L1", "q": 4})
+    assert await _until(lambda: not rt.is_running())
+    assert "pw_leave" not in _types(radio)
+    assert writes[-1] == (0, "ledsOff", ())
