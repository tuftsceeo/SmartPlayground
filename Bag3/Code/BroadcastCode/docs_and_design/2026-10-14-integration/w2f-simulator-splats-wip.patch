diff --git a/Bag3/Code/Simulator/py/shims/sim_splats.py b/Bag3/Code/Simulator/py/shims/sim_splats.py
new file mode 100644
index 0000000..7caffab
--- /dev/null
+++ b/Bag3/Code/Simulator/py/shims/sim_splats.py
@@ -0,0 +1,132 @@
+"""
+The wand's paired Splats, simulated.
+
+Fake BLE links stand in for splat_link.SplatLink, under the real
+splat_api.SplatGroup and pairing.LocalSplats, so games and party.py / solo.py
+drive the vendored code unchanged. Every link write goes to the host
+callback set with set_write_callback(): cb(index, op, args), op one of
+"leds" (r, g, b), "sound" (idx,), "noteOn" (value, octave),
+"noteOff" (value, octave), "tasksOff" (), "ledsOff" ().
+
+Local Splats are auto-paired: ensure(n) builds pairing's LocalSplats over n
+ready links, without BLE or /pairing.json. The host presses a Splat with
+press(i) / release(i) and drops its link with set_ready(i, False).
+"""
+
+import sim_state
+
+_write_cb = None
+_links = []
+_local = None
+
+
+def set_write_callback(cb):
+    global _write_cb
+    _write_cb = cb
+
+
+def splat_mac(own_mac, i):
+    return "5A:00:00:00:%02X:%02X" % (int(own_mac[-2:], 16), i)
+
+
+class FakeSplatLink:
+    """splat_link.SplatLink surface used by splat_api and pairing."""
+
+    def __init__(self, index, ready=True):
+        self.index = index
+        self.ready = ready
+        self.events = []
+        self.scan_gate = None
+
+    def service(self, now_ms):
+        pass
+
+    def take_events(self):
+        ev, self.events = self.events, []
+        return ev
+
+    def _w(self, op, *args):
+        if _write_cb is not None:
+            _write_cb(self.index, op, list(args))
+        return True
+
+    def keepAlive(self):
+        return True
+
+    def readSwitches(self):
+        return True
+
+    def setLEDsON(self, rgb):
+        return self._w("leds", *tuple(rgb))
+
+    def playSound(self, idx, vol):
+        return self._w("sound", idx)
+
+    def noteOn(self, v, vel, octave, inst):
+        return self._w("noteOn", v, octave)
+
+    def noteOff(self, v, vel, octave, inst):
+        return self._w("noteOff", v, octave)
+
+    def allTasksOff(self):
+        return self._w("tasksOff")
+
+    def allLEDsOff(self):
+        return self._w("ledsOff")
+
+    def close(self):
+        self.ready = False
+
+
+class FakeHub:
+    def __init__(self, n):
+        self.links = [FakeSplatLink(i) for i in range(n)]
+
+
+def ensure(n, own_mac=None):
+    """pairing's LocalSplats over n links (None for n == 0). Reused while
+    the count is unchanged, so link state survives a restart."""
+    global _links, _local
+    import pairing
+    if n <= 0:
+        _links = []
+        _local = None
+        pairing._local = None
+        return None
+    if _local is not None and len(_links) == n:
+        pairing._local = _local
+        return _local
+    from splat_api import SplatGroup
+    own = own_mac or sim_state.mac_to_str(sim_state.own_mac).upper()
+    hub = FakeHub(n)
+    _links = hub.links
+    macs = [splat_mac(own, i) for i in range(n)]
+    _local = pairing.LocalSplats(hub, SplatGroup(hub), macs, own, "/pairing.json")
+    while _local.poll() is not None:     # boot-time splat_back events
+        pass
+    pairing._local = _local
+    return _local
+
+
+def count():
+    return len(_links)
+
+
+def macs():
+    return [] if _local is None else _local.macs
+
+
+def press(i):
+    _links[i].events.append(1)
+
+
+def release(i):
+    _links[i].events.append(0)
+
+
+def set_ready(i, up):
+    _links[i].ready = bool(up)
+
+
+def is_ready(i):
+    return _links[i].ready
