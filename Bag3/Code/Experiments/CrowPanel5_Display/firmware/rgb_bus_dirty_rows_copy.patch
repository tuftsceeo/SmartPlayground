diff --git a/ext_mod/lcd_bus/esp32_src/rgb_bus_rotation.c b/ext_mod/lcd_bus/esp32_src/rgb_bus_rotation.c
index efb8ae0..1415044 100644
--- a/ext_mod/lcd_bus/esp32_src/rgb_bus_rotation.c
+++ b/ext_mod/lcd_bus/esp32_src/rgb_bus_rotation.c
@@ -210,6 +210,11 @@
         bool last_update;
 
         uint8_t bytes_per_pixel = self->bytes_per_pixel;
+        // Rows touched since the last buffer swap; only these are re-synced after a swap, so the
+        // task does not copy the whole frame PSRAM-to-PSRAM and starve the bounce-buffer refill.
+        uint32_t dirty_y0 = self->height;
+        uint32_t dirty_y1 = 0;
+        bool dirty_any = false;
         rgb_bus_lock_acquire(&self->copy_lock, -1);
 
         self->init_err = LCD_OK;
@@ -231,6 +236,15 @@
                 self->width, self->height,
                 bytes_per_pixel, self->rotation, self->rgb565_dither);
 
+            if (self->rotation != RGB_BUS_ROTATION_0) {
+                dirty_y0 = 0;
+                dirty_y1 = self->height - 1;
+            } else {
+                if (self->y_start < dirty_y0) dirty_y0 = self->y_start;
+                if (self->y_end > dirty_y1) dirty_y1 = self->y_end;
+            }
+            dirty_any = true;
+
             rgb_bus_lock_release(&self->tx_color_lock);
 
             if (self->callback != mp_const_none) {
@@ -278,7 +292,15 @@
                 } else {
                     rgb_bus_event_clear(&self->swap_bufs);
                     rgb_bus_event_wait(&self->swap_bufs);
-                    memcpy(self->idle_fb, self->active_fb, self->width * self->height * bytes_per_pixel);
+                    if (dirty_any) {
+                        if (dirty_y1 >= self->height) dirty_y1 = self->height - 1;
+                        size_t row = (size_t)self->width * bytes_per_pixel;
+                        memcpy(self->idle_fb + dirty_y0 * row, self->active_fb + dirty_y0 * row,
+                               (dirty_y1 - dirty_y0 + 1) * row);
+                    }
+                    dirty_y0 = self->height;
+                    dirty_y1 = 0;
+                    dirty_any = false;
                 }
             }
 
